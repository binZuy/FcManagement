# Database (Supabase pooler dùng cổng 6543 cho Transaction Mode, 5432 cho Direct)
# DATABASE_URL: dùng cho app runtime (qua pgbouncer pooler)
# DIRECT_URL: dùng cho Prisma CLI (db push / db seed) — bypass pooler, cần cho migrations
DATABASE_URL="postgresql://user:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:pass@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3005"

# Google OAuth (tạo tại console.cloud.google.com)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# SePay
SEPAY_API_TOKEN=""
SEPAY_WEBHOOK_SECRET=""

# QR Thanh toán (NEXT_PUBLIC_ → an toàn để dùng ở client)
# BIN ngân hàng: MB=970422, VCB=970436, TCB=970407, VPBank=970432, BIDV=970418
NEXT_PUBLIC_BANK_BIN="970436"
NEXT_PUBLIC_ACCOUNT_NO="0000000001"
NEXT_PUBLIC_ACCOUNT_NAME="HO KINH DOANH TEST 3A7F"
NEXT_PUBLIC_TRANSFER_PREFIX="FCKTX"

# Timezone
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Supabase Storage (dùng để upload ảnh MOTM, ảnh trận đấu)
# NEXT_PUBLIC_SUPABASE_URL: URL project Supabase (lấy tại Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# --- Supabase API Keys mới (thay thế anon/service_role cũ, retire 2027) ---
# SUPABASE_SECRET_KEY: Secret key — bypass RLS, dùng server-side only (KHÔNG để lộ ra client)
# Lấy tại: Supabase Dashboard → Project Settings → API Keys → "Secret key" (tạo mới nếu chưa có)
SUPABASE_SECRET_KEY=""

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Publishable key — an toàn dùng client-side, cần RLS bật
# Lấy tại: Supabase Dashboard → Project Settings → API Keys → "Publishable key" (tạo mới nếu chưa có)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# SUPABASE_STORAGE_BUCKET: Tên bucket lưu ảnh (tạo tại Supabase Storage → New bucket → Public = ON)
SUPABASE_STORAGE_BUCKET="fc-photos"
# Telegram (build sẵn, chưa dùng - comment out)
# TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# TELEGRAM_CHAT_ID="your-telegram-group-chat-id"

ADMIN_EMAIL="admin@email.com"

